FROM registry.access.redhat.com/ubi9/ubi@sha256:5426a8f45e80a07168a30ea24d84f266094b3756624a5508cc53927e6ee39e09 AS build

ARG SOURCE_DATE_EPOCH
COPY rpm-bundle /workspace/rpm-bundle
COPY RPM-BUNDLE.sha256 /workspace/RPM-BUNDLE.sha256
COPY icu-tools /workspace/icu-tools
RUN test -n "${SOURCE_DATE_EPOCH}" \
    && cd /workspace/rpm-bundle \
    && sha256sum -c /workspace/RPM-BUNDLE.sha256 \
    && rpm -Uvh /workspace/rpm-bundle/build/*.rpm

COPY lto-ltfs-0.1.0.tar.gz /workspace/SOURCES/lto-ltfs-0.1.0.tar.gz
COPY SOURCE-MANIFEST.json /workspace/SOURCE-MANIFEST.json
COPY lto-ltfs.spec /workspace/SPECS/lto-ltfs.spec
COPY 99-lto-ltfs.rules lto-ltfs.conf /workspace/SOURCES/
COPY verify-rpm.py /workspace/verify-rpm.py

RUN mkdir -p /workspace/BUILD /workspace/BUILDROOT /workspace/RPMS \
        /workspace/SRPMS /workspace/probe-source /artifacts /home/builder \
    && chown -R 1001:0 /workspace /artifacts /home/builder

USER 1001:0
ENV HOME=/home/builder

RUN tar -xzf /workspace/SOURCES/lto-ltfs-0.1.0.tar.gz -C /workspace/probe-source \
    && python3 -B /workspace/probe-source/lto-ltfs-0.1.0/scripts/verify-public-build.py \
        --lock /workspace/probe-source/lto-ltfs-0.1.0/packaging/rpm/icu-build-tools.json \
        --authenticate-icu-tools /workspace/icu-tools \
    && bash /workspace/probe-source/lto-ltfs-0.1.0/scripts/verify-icu-catalogs.sh \
        /workspace/icu-tools /workspace/probe-source/lto-ltfs-0.1.0

RUN PATH=/workspace/icu-tools:/usr/bin:/bin LD_BIND_NOW=1 \
        SOURCE_DATE_EPOCH="${SOURCE_DATE_EPOCH}" rpmbuild -ba \
        --define '_topdir /workspace' \
        --define "source_date_epoch ${SOURCE_DATE_EPOCH}" \
        /workspace/SPECS/lto-ltfs.spec \
    && test "$(find /workspace/SRPMS -maxdepth 1 -type f -name '*.src.rpm' | wc -l)" -eq 1 \
    && test "$(find /workspace/RPMS/x86_64 -maxdepth 1 -type f -name '*.x86_64.rpm' | wc -l)" -eq 1 \
    && python3 /workspace/verify-rpm.py --srpm /workspace/SRPMS/*.src.rpm \
        --source-manifest /workspace/SOURCE-MANIFEST.json \
    && python3 /workspace/verify-rpm.py /workspace/RPMS/x86_64/*.x86_64.rpm \
    && cp /workspace/SOURCES/lto-ltfs-0.1.0.tar.gz \
        /workspace/SOURCE-MANIFEST.json /workspace/SRPMS/*.src.rpm \
        /workspace/RPMS/x86_64/*.x86_64.rpm /artifacts/ \
    && rpm -qp --qf '%{PAYLOADDIGESTALGO}:%{PAYLOADDIGEST}\n' \
        /artifacts/*.x86_64.rpm > /artifacts/RPM-PAYLOAD-DIGEST \
    && python3 -B /workspace/probe-source/lto-ltfs-0.1.0/scripts/verify-public-build.py \
        --lock /workspace/probe-source/lto-ltfs-0.1.0/packaging/rpm/icu-build-tools.json \
        --write-build-inputs /artifacts/BUILD-INPUTS.json \
    && cd /artifacts \
    && sha256sum BUILD-INPUTS.json lto-ltfs-0.1.0.tar.gz SOURCE-MANIFEST.json \
        *.src.rpm *.x86_64.rpm RPM-PAYLOAD-DIGEST > SHA256SUMS

FROM registry.access.redhat.com/ubi9/ubi@sha256:5426a8f45e80a07168a30ea24d84f266094b3756624a5508cc53927e6ee39e09 AS runtime-test

COPY rpm-bundle /workspace/rpm-bundle
COPY RPM-BUNDLE.sha256 /workspace/RPM-BUNDLE.sha256
COPY --from=build /artifacts /artifacts
RUN cd /workspace/rpm-bundle \
    && sha256sum -c /workspace/RPM-BUNDLE.sha256 \
    && rpm -Uvh /workspace/rpm-bundle/runtime/*.rpm /artifacts/*.x86_64.rpm \
    && test -x /usr/bin/fusermount \
    && ltfs --version \
    && ltfsck --version \
    && mkltfs --version \
    && ltfs-info --version \
    && ltfs-info --self-test-fixture ready > /tmp/ltfs-info-fixture.json \
    && grep -Fqx '{"schema":2,"media_state":"ltfs","tape_by_id":"/dev/tape/by-id/self-test-nst","scsi_by_id":"/dev/lto-archiver-scsi-self-test-sg","drive_serial":"SELFTEST","mam_barcode":"SELFTEST01","mam_volume_serial":"SELFTEST-SERIAL-01","ltfs_volume_label":"SELF TEST","ltfs_volume_uuid":"11111111-2222-3333-4444-555555555555","index_generation":1}' /tmp/ltfs-info-fixture.json \
    && test "$(wc -l < /tmp/ltfs-info-fixture.json)" -eq 1 \
    && rpm -V lto-ltfs \
    && rpm -e lto-ltfs \
    && test ! -e /usr/bin/ltfs \
    && test ! -e /usr/bin/ltfsck \
    && test ! -e /usr/bin/mkltfs \
    && test ! -e /usr/bin/ltfs-info

FROM scratch AS artifacts
COPY --from=runtime-test /artifacts/ /
